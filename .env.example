# Variables optionnelles de BrightBean Studio sur Coolify.
# À renseigner dans Coolify > Environment Variables, uniquement celles dont vous
# avez besoin, puis Redeploy. Ce fichier n'est pas lu par Coolify.
#
# Générées automatiquement par Coolify, NE PAS définir ici :
#   SERVICE_PASSWORD_64_SECRETKEY       SECRET_KEY de Django
#   SERVICE_PASSWORD_64_ENCRYPTIONSALT  ENCRYPTION_KEY_SALT
#   SERVICE_PASSWORD_POSTGRES           mot de passe PostgreSQL
#   SERVICE_URL_CADDY                   URL publique https (APP_URL)
#   SERVICE_FQDN_CADDY                  hôte public (ALLOWED_HOSTS)
#   SERVICE_FQDN_CADDY_80               routage du proxy Coolify vers caddy

# --- Version amont -------------------------------------------------------------
# SHA complet (40 caractères) d'un commit de brightbeanxyz/brightbean-studio.
# L'amont ne publie ni release ni tag.
BRIGHTBEAN_REF=6c56e1f9190fb3e2571ee3f0c1d99b2d818aa9f8

# --- Email ---------------------------------------------------------------------
# console (défaut) : les emails sont écrits dans les logs du service app.
# smtp : envoi réel, STARTTLS uniquement (l'amont ne lit pas EMAIL_USE_SSL).
EMAIL_BACKEND_TYPE=console
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@localhost

# --- Connexion "Continuer avec Google" (distinct de PLATFORM_GOOGLE_*) ----------
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# --- Identifiants des plateformes ----------------------------------------------
# Prioritaires sur ceux saisis par organisation dans /admin/.
# Callback OAuth : https://<domaine>/social-accounts/callback/<plateforme>/
# (TikTok : social1 au lieu de tiktok). Détails : section "Platform Credentials"
# du README amont.
# Meta : Facebook et Instagram partagent l'app. CONFIG_ID optionnel
# (Facebook Login for Business).
PLATFORM_FACEBOOK_APP_ID=
PLATFORM_FACEBOOK_APP_SECRET=
PLATFORM_FACEBOOK_CONFIG_ID=
# Instagram direct (Instagram Login, sans page Facebook liée)
PLATFORM_INSTAGRAM_APP_ID=
PLATFORM_INSTAGRAM_APP_SECRET=
# Threads : identifiants propres ("Threads App ID"), pas ceux de Facebook
PLATFORM_THREADS_APP_ID=
PLATFORM_THREADS_APP_SECRET=
# LinkedIn : app personnelle (OIDC + Share) et/ou app entreprise
# (Community Management API, réutilisée pour le personnel si seule présente)
PLATFORM_LINKEDIN_PERSONAL_CLIENT_ID=
PLATFORM_LINKEDIN_PERSONAL_CLIENT_SECRET=
PLATFORM_LINKEDIN_COMPANY_CLIENT_ID=
PLATFORM_LINKEDIN_COMPANY_CLIENT_SECRET=
PLATFORM_TIKTOK_CLIENT_KEY=
PLATFORM_TIKTOK_CLIENT_SECRET=
# Google : YouTube et Google Business Profile partagent le client OAuth
PLATFORM_GOOGLE_CLIENT_ID=
PLATFORM_GOOGLE_CLIENT_SECRET=
PLATFORM_PINTEREST_APP_ID=
PLATFORM_PINTEREST_APP_SECRET=
# Bluesky, Mastodon et DEV.to n'ont pas d'identifiants globaux : ils se
# connectent compte par compte depuis l'interface.

# --- Webhooks entrants (vides : les webhooks sont rejetés) ----------------------
# Jetons de vérification Meta : valeurs libres, à recopier à l'identique dans la
# configuration webhook de l'app Meta (callback https://<domaine>/webhooks/facebook/).
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_LOGIN_WEBHOOK_VERIFY_TOKEN=
# Secret HMAC des notifications PubSubHubbub de YouTube (valeur libre)
YOUTUBE_WEBHOOK_SECRET=

# --- Stockage des médias ---------------------------------------------------------
# local (défaut) : volume media_data, servi par caddy.
# s3 : stockage objet compatible S3 (SeaweedFS, MinIO, R2, etc.). Passer alors
# CADDY_MEDIA_ROOT à /var/empty. Les fichiers déjà présents ne sont pas migrés.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_CUSTOM_DOMAIN=
S3_REGION_NAME=auto
CADDY_MEDIA_ROOT=/app/media

# --- Divers ----------------------------------------------------------------------
# Recherche de photos Unsplash dans le composer (https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=
# Suivi d'erreurs
SENTRY_DSN=
